# FX Discovery — Environment Variables
# Copy this to .env and fill in your keys
# WARNING: Never commit .env to git — it contains real credentials

# === REQUIRED ===
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# === AI PROVIDER CONFIG (v2 pipeline — packages/pipeline) ===
# The v2 analyse stage makes ONE event-level LLM call (combined Brain 1 + Brain 2).
# Provider is selected by AI_PROVIDER: "groq" (default) or "gemini".
# On a 429 / rate-limit it falls back to a rule-based event automatically.
AI_PROVIDER=groq

# Groq — OpenAI-compatible chat completions. Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — only used when AI_PROVIDER=gemini (and by the legacy scripts/ pipeline)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# === LEGACY scripts/ pipeline only (ingest.py etc.) ===
# Set USE_PLAYBOOK_FALLBACK=false to raise an error instead of falling back to rules
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=grok
USE_PLAYBOOK_FALLBACK=true
# xAI / Grok — NOT funded / not in use; left here for the legacy scripts only
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3-mini-fast

# === RATE LIMIT CONTROLS (Companies House / ingest) ===
# How many new events to analyse per run (1 LLM call per event now)
# Start low if you're hitting 429s — increase once working
DISCOVERY_MAX_EVENTS=2

# How many companies to fetch per CH search term
# 20 is good — gives volume without hammering CH
DISCOVERY_MAX_COMPANIES_PER_TERM=20

# === WEB-FIRST DISCOVERY (discover_web.py) ===
# Set to false to skip web discovery entirely and use CH-only mode
WEB_DISCOVERY_ENABLED=true

# How many events to process in one web discovery run
# Each event × segments × queries × results = requests. Start low.
WEB_MAX_EVENTS=5

# Max segments to search per event.
# Exposure mapper produces 8-12 for broad currency events, 4-8 for niche events.
WEB_MAX_SEGMENTS_PER_EVENT=10

# Max micro-categories to search per segment (each segment has 3-5 micro-cats)
# Architecture: segment → micro_categories → search_queries
WEB_MAX_MICRO_CATEGORIES_PER_SEGMENT=3

# Max search queries per micro-category (each micro-cat has 2-3 queries)
WEB_MAX_QUERIES_PER_MICRO_CATEGORY=2

# Max search queries to run per segment (used for old events without micro_categories)
WEB_MAX_QUERIES_PER_SEGMENT=5

# Max result URLs to visit per query (each visit = 1-2 HTTP requests)
# Keep low to conserve quota — 5 is a good balance of volume vs speed
WEB_MAX_RESULTS_PER_QUERY=5

# Politeness delay between DuckDuckGo requests (seconds)
# DDG rate-limits aggressive scrapers — keep at 2.0+ to avoid blocks
WEB_REQUEST_DELAY_SECONDS=2.5

# === CATEGORY PRIORITY ENGINE ===
# Brain 1 (Gemini) scores each segment 0-100 on commercial FX opportunity.
# Brain 2 (discover_web.py) only scrapes segments scoring ≥ threshold, up to max categories.
# This prevents wasting scraping budget on weak/indirect FX segments.
WEB_MAX_CATEGORIES_TO_SCRAPE=6
CATEGORY_MIN_SCORE_TO_SCRAPE=65
